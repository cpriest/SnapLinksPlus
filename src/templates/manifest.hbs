{
	{{! The background runs as an event page in Firefox and as a service worker in Chrome, both unloaded when idle, see CONTEXT-GRAPH.md }}
	"manifest_version":			3,
	"name":						"{{package.FullName}}",
{{#Firefox}}        {{! Needs 1.2.3-beta1 or 1.2.3 format }}
	"version":                "{{package.version}}",
{{/Firefox}}
{{#Chrome}}            {{! Needs 1.2.3.1 for version, accepts anything for version_name }}
	"version":                "{{quad_version}}",
	"version_name":           "{{package.version}}",
{{/Chrome}}
	"author":                 "{{package.author}}",
	"description":            "{{package.description}}",
	"homepage_url":           "{{package.homepage}}",

{{#Chrome}}		{{! 116: runtime.getContexts(), used with the offscreen document that copies }}
	"minimum_chrome_version": "116",
{{/Chrome}}

{{#Firefox}}
	"permissions":            [
		"cookies",
		"storage",
		"notifications",
		"clipboardWrite",
		"browserSettings"
	],
{{/Firefox}}
{{#Chrome}}
	"permissions":            [
		"cookies",
		"storage",
		"notifications",
		"clipboardWrite",
		"offscreen"
	],
{{/Chrome}}

	"optional_permissions":   [
		"bookmarks"
	],

	"icons":                  {
		"48":  "res/SnapLinksLogo48.png",
		"128": "res/SnapLinksLogo128.png"
	},

{{#Firefox}}
		"browser_specific_settings": {
			"gecko": {
				"id":                        "snaplinks@snaplinks.mozdev.org",
				"strict_min_version":        "142.0",
				"data_collection_permissions": {
					"required": ["none"]
				}
			}
		},
{{/Firefox}}

	"background":             {
{{#Chrome}}
		"service_worker": "src/background-scripts/service-worker.js"
{{/Chrome}}
{{#Firefox}}
		"scripts": [
			"src/StoragePrefs.js",
			"src/globals.js",
			{{#DevBuild}}
				"src/background-scripts/DevBuild.js",
			{{/DevBuild}}
			"src/background-scripts/background.js"
		]
{{/Firefox}}
	},
	"commands":               {
		{{#DevBuild}}
			"dev-do-1": {
				"suggested_key": {
					"default": "Alt+X"
				},
				"description":   "Dev: Execute devFunc1()"
			},
			"dev-do-2": {
				"suggested_key": {
					"default": "Alt+C"
				},
				"description":   "Dev: Execute devFunc2()"
			}
		{{/DevBuild}}
	},
	"content_scripts":        [
		{
			"run_at": "document_end",
			"match_about_blank": true,
			"all_frames": true,

			"matches": [ "<all_urls>" ],

			"js": [
				{{#Chrome}}
					"src/lib/browser-polyfill.js",
				{{/Chrome}}
				"src/StoragePrefs.js",
				"src/CSP.js",
				"src/globals.js",
				{{#DevBuild}}
					"src/content-scripts/DevBuild.js",
				{{/DevBuild}}
				"src/content-scripts/Utility.js",
				"src/content-scripts/SelectionRect.js",
				"src/content-scripts/ElementIndexer.js",
				"src/content-scripts/SvgOverlay.js",
				"src/content-scripts/CategorizedCollection.js",
				"src/content-scripts/ActionMgr.js",
				"src/content-scripts/EventHandler.js"
			]
		}
	],
	"options_ui":             {
		"page":			"src/html/options.html"
	}
}
